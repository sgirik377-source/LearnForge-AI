# LearnForge AI Environment Variables
APP_NAME="LearnForge AI"
DATABASE_URL="sqlite:///./learnforge.db"
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
